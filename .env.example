# =============================================
# OPENCLAW Platform - Environment Variables Example
# =============================================
# このファイルは公開リポジトリにコミットされる**テンプレート**です。
# 値は絶対に書かない（変数名のみ、または例として明らかに偽の値）。
#
# 開発時は .env.local にコピーして実値を入れる:
#   cp .env.example .env.local
#
# 各 Cloudflare Workers では wrangler secret put <NAME> でセットする（SPEC-11 §3.4）。
# 各 Cloudflare Pages では Pages の環境変数設定UIで設定する。
#
# 機密度マーカー（SPEC-11 §2.3 の階層に対応）:
#   [TOP] = 最高機密（HSM/Vault推奨、絶対に漏らさない）
#   [HIGH] = 高機密（暗号化保管、ローテーション対象）
#   [MID] = 中機密（内部 API キー、定期ローテ）
#   [LOW] = 低機密（公開可、NEXT_PUBLIC_ プレフィックス含む）
# =============================================


# =============================================
# Webアプリ (apps/web/) - Next.js
# =============================================

# ---------- Supabase ----------
# [LOW]
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# [LOW]
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt
# [TOP] - 絶対にコミットしない。漏洩時は Supabase ダッシュボードで即再生成。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# ---------- アプリケーション全体 ----------
# [LOW]
NEXT_PUBLIC_APP_URL=https://openclaw.com
# [LOW]
NEXT_PUBLIC_APP_DOMAIN=openclaw.com
# [LOW] - development / staging / production
NODE_ENV=development

# ---------- Web3 / Polygon ----------
# [LOW]
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com
# [LOW]
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# [LOW]
NEXT_PUBLIC_REWARD_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# [LOW] - Polygon 版 USDT（固定）
NEXT_PUBLIC_USDT_CONTRACT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
# [LOW] - WalletConnect Cloud で発行
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# ---------- 紹介・運営デフォルト ----------
# [LOW] - 紹介者なし購入時のデフォルト紐付け先（仁さんの運営ウォレット）
NEXT_PUBLIC_ADMIN_DEFAULT_REFERRER_WALLET=0x0000000000000000000000000000000000000000

# ---------- Telegram ----------
# [LOW]
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=openclaw_bot

# ---------- Stripe（Academy / 武器の決済、JPY） ----------
# [LOW]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# [TOP]
STRIPE_SECRET_KEY=sk_test_xxx
# [HIGH]
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- メール送信 (Resend) ----------
# [HIGH]
RESEND_API_KEY=re_xxx
# [LOW]
EMAIL_FROM_ADDRESS=noreply@openclaw.com

# ---------- 内部 API（Web → Workers） ----------
# [LOW]
REWARD_CALCULATOR_URL=https://reward-calc.openclaw.com
# [MID]
REWARD_CALCULATOR_API_KEY=internal-secret
# [LOW]
HP_GENERATOR_URL=https://hp-gen.openclaw.com
# [MID]
HP_GENERATOR_API_KEY=internal-secret
# [LOW]
SNS_POSTER_URL=https://sns.openclaw.com
# [MID]
SNS_POSTER_API_KEY=internal-secret
# [LOW]
NOTIFICATION_URL=https://notify.openclaw.com
# [MID]
NOTIFICATION_API_KEY=internal-secret
# [LOW]
BOT_WORKER_URL=https://bot.openclaw.com

# ---------- 管理者 ----------
# [LOW] - DB 上の運営者 user_id（紹介者なし購入のデフォルト紐付け先）
ADMIN_DEFAULT_REFERRER_USER_ID=00000000-0000-0000-0000-000000000000
# [LOW] - 仁さんの Telegram ユーザーID
ADMIN_TELEGRAM_USER_ID=12345678
# [LOW]
ADMIN_EMAIL=admin@openclaw.com

# ---------- Webhook 署名 ----------
# [HIGH]
WEBHOOK_SIGNATURE_SECRET=replace-with-strong-random-32-chars


# =============================================
# Telegram Bot (apps/bot/) - Cloudflare Workers
# =============================================
# wrangler.toml と wrangler secret put で設定

# [HIGH]
TELEGRAM_BOT_TOKEN=123456789:AAA-replace-with-real-token
# [LOW]
TELEGRAM_BOT_USERNAME=openclaw_bot
# [HIGH]
TELEGRAM_WEBHOOK_SECRET=replace-with-strong-random

# [HIGH]
ANTHROPIC_API_KEY=sk-ant-xxx
# [LOW] - 実装時の最新を使用 (例: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase（Worker 側、上記と同値）
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY を別途 wrangler secret put

# [LOW] - 各 Worker 側でも参照
NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
POLYGON_RPC_URL=https://polygon-rpc.com


# =============================================
# Reward Calculator (apps/workers/reward-calculator/)
# =============================================

# [TOP] - 報酬分配用ホットウォレット秘密鍵。HSM/Vault推奨。
PRIVATE_KEY_REWARD_DISTRIBUTOR=0xreplace-with-private-key

# [LOW]
REWARD_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# [LOW]
USDT_CONTRACT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
# [LOW] - 売上受取アドレス（運営）
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# [HIGH] - 失敗通知用 (Discord Webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy


# =============================================
# HP Generator (apps/workers/hp-generator/)
# =============================================

# Cloudflare API（Pages デプロイ + DNS 操作）
# [HIGH]
CLOUDFLARE_ACCOUNT_ID=xxx
# [HIGH]
CLOUDFLARE_API_TOKEN=xxx
# [HIGH]
CLOUDFLARE_ZONE_ID=xxx
# [LOW]
CLOUDFLARE_PAGES_PROJECT_NAME=openclaw-user-sites


# =============================================
# SNS Poster (apps/workers/sns-poster/) - MVP2
# =============================================

# X (Twitter) API v2 - OAuth 2.0 + PKCE
# [HIGH]
X_CLIENT_ID=xxx
# [HIGH]
X_CLIENT_SECRET=xxx
# [HIGH]
X_BEARER_TOKEN=xxx

# [HIGH] - DB に保存するアクセストークン暗号化用 (32文字 hex)
ENCRYPTION_KEY=replace-with-32-char-random-hex


# =============================================
# Push Notification (apps/workers/push-notification/)
# =============================================
# 上記の TELEGRAM_BOT_TOKEN, RESEND_API_KEY, ANTHROPIC_API_KEY を共有


# =============================================
# Foundry / Smart Contract デプロイ用
# (apps/contracts/)
# =============================================

# [TOP] - スマコンデプロイヤー秘密鍵。本番では MultiSig 経由を推奨。
PRIVATE_KEY_DEPLOYER=0xreplace-with-private-key

# [LOW] - Polygon Mainnet RPC（公開だが実装時は Alchemy / QuickNode 等の独自 RPC を推奨）
# POLYGON_RPC_URL=https://polygon-rpc.com（上記と同値）
# [LOW] - Amoy testnet
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# [HIGH] - 自動 Verify 用
POLYGONSCAN_API_KEY=xxx

# [LOW] - メタデータ JSON のホスト URL
BASE_URI=https://api.openclaw.com/metadata/

# [LOW] - 報酬分配用ホットウォレットのアドレス（DISTRIBUTOR_ROLE 付与先）
BOT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000


# =============================================
# Backup Worker (apps/workers/backup/)
# =============================================
# Cloudflare R2 への日次バックアップ用
# [HIGH]
# BACKUP_BUCKET は wrangler.toml の R2 binding で参照（環境変数不要）


# =============================================
# 備考
# =============================================
# - SPEC-11 §2.1 を一次資料とする。本ファイルとの差分は SPEC-11 を真とする。
# - 各 Worker の wrangler.toml には [vars] と secret を分けて記載すること。
# - 本番ローンチ前に SPEC-11 §16 のチェックリストで全項目を確認。
