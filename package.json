{
  "name": "openclaw-platform",
  "version": "0.1.0",
  "private": true,
  "description": "OPENCLAW Platform - 30体ザリガニ型AIエージェントNFT「Claws」を中心とした集客支援＆学習エコシステム",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "extract:characters": "python scripts/extract-characters.py"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "prettier": "^3.4.2"
  },
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
